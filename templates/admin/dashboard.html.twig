{% extends 'base.html.twig' %}

{% block title %}Tableau de bord admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin-dashboard-styles.css') }}">
{% endblock %}

{% block body %}
    <h1 class="admin-dashboard-title">Bienvenue dans l'administration</h1>

    <section class="admin-dashboard-section">
        <h2 class="admin-section-title">Gestion des Produits</h2>
        <ul class="admin-dashboard-list">
            <li class="admin-dashboard-list-item">
                <a href="{{ path('admin_product_add') }}" class="admin-btn-primary">Ajouter un produit</a>
            </li>
            <li class="admin-dashboard-list-item">
                <a href="{{ path('admin_product_list') }}" class="admin-btn-secondary">Gérer les produits</a>
            </li>
            <li class="admin-dashboard-list-item">
                <a href="{{ path('admin_featured_products') }}" class="admin-btn-info">Gérer les produits en avant</a>
            </li>
        </ul>
    </section>

    <section class="admin-dashboard-section">
        <h2 class="admin-section-title">Gestion des Commandes</h2>
        <ul class="admin-dashboard-list">
            <li class="admin-dashboard-list-item">
                <a href="{{ path('admin_order_list') }}" class="admin-btn-info">Voir les commandes</a>
            </li>
        </ul>
    </section>
{% endblock %}

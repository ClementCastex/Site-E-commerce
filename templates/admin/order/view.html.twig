{% extends 'base.html.twig' %}

{% block title %}Détails de la commande{% endblock %}

{% block body %}
    <h1>Détails de la commande {{ order.orderNumber }}</h1>
    <p><strong>Date :</strong> {{ order.createdAt|date('d/m/Y') }}</p>
    <p><strong>Client :</strong> {{ order.user.username }}</p>
    <p><strong>Adresse de livraison :</strong> {{ order.shippingAddress }}</p>
    <p><strong>Numéro de téléphone :</strong> {{ order.phoneNumber }}</p>
    <p><strong>Status :</strong> {{ order.status }}</p>

    <h2>Articles :</h2>
    <ul>
        {% for item in order.orderItems %}
            <li>
                {{ item.product.name }} - Quantité : {{ item.quantity }} - Prix unitaire : {{ item.price }}€
            </li>
        {% endfor %}
    </ul>

<p><strong>Total :</strong> {{ totalPrice }}€</p>

{% endblock %}